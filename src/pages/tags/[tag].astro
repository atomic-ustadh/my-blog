---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import TagComponent from '../../components/Tag.astro';

// Generate static pages for each tag at build time
export async function getStaticPaths() {
  const all = await getCollection('blog');
  const tags = new Set();
  all.forEach((p) => (p.data.tags || []).forEach((t) => tags.add(String(t).toLowerCase())));

  return Array.from(tags).map((t) => ({ params: { tag: encodeURIComponent(t) } }));
}

// Safely read and decode the tag param (editor/TS-friendly)
const rawTag = Astro.params?.tag;
let paramTag = '';
if (rawTag) {
  try {
    paramTag = decodeURIComponent(String(rawTag)).toLowerCase();
  } catch {
    paramTag = String(rawTag).toLowerCase();
  }
}

const posts = (await getCollection('blog'))
  .filter((p) => (p.data.tags || []).map((t) => t.toLowerCase()).includes(paramTag))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={`Tag: ${Astro.params.tag}`} description={`Posts tagged with ${Astro.params.tag}`} />
  </head>
  <body>
    <Header />
    <main>
      <h1>Tag: {Astro.params.tag}</h1>
      {posts.length === 0 ? (
        <p>No posts found with this tag.</p>
      ) : (
        <ul>
          {posts.map((p) => (
            <li>
              <a href={`/blog/${p.id}/`}>{p.data.title}</a>
              <div class="meta">
                <FormattedDate date={p.data.pubDate} />
                {p.data.tags && p.data.tags.map((t) => <TagComponent tag={t} />)}
              </div>
            </li>
          ))}
        </ul>
      )}
    </main>
    <Footer />
  </body>
</html>
